{
  "name": "d2-visualizer",
  "private": true,
  "version": "0.2.0",
  "description": "Professional desktop music visualizer and lightweight video editor",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "tsc && vite build",
    "dist:win": "npm run build && electron-builder --win --x64 --config electron-builder.json5",
    "preview": "vite preview",
    "test:performance": "node scripts/test_performance.cjs",
    "test:timeline": "node scripts/test_timeline_scrub.cjs",
    "test": "node --test scripts/performance.test.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "three": "^0.187.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.2",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
